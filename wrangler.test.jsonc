// Config SOLO para Vitest. Sin AI: el Worker cae a la ficha manual (degradación real); los tests
// del camino con IA inyectan una IA falsa en las dependencias del handler
{
  "name": "ficha-de-rol-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "KV", "id": "test" }],
  "durable_objects": { "bindings": [{ "name": "CONTADOR", "class_name": "Contador" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Contador"] }],
  "vars": {
    "MODELO_TEXTO": "@cf/qwen/qwen3-30b-a3b-fp8",
    "MODELO_TEXTO_RESPALDO": "@cf/openai/gpt-oss-20b",
    "MODELO_IMAGEN": "@cf/black-forest-labs/flux-1-schnell",
    "MODELO_GUARDIA": "@cf/meta/llama-guard-3-8b",
    "CUOTA_NEURONAS_DIA": "6000",
    "RESERVA_NEURONAS": "130",
    "TOPE_IA_IP_DIA": "5",
    "TOPE_FICHAS_IP_DIA": "20",
    "TOPE_BYTES_KV": "800000000"
  }
}
